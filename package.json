{
  "name": "figmagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-node.mjs --test test/serializers.test.ts",
    "benchmark": "node scripts/run-node.mjs benchmark/format.ts",
    "check": "biome check . && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@figma/plugin-typings": "1.133.0",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "gpt-tokenizer": "3.4.0",
    "typescript": "7.0.2"
  }
}
